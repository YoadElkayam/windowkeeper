{
  "name": "windowkeeper",
  "version": "0.1.0",
  "description": "Lossless context management for AI agent harnesses. The archive is the truth, the window is a view, and the ledger says what moved where.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoadElkayam/windowkeeper.git"
  },
  "homepage": "https://github.com/YoadElkayam/windowkeeper#readme",
  "bugs": "https://github.com/YoadElkayam/windowkeeper/issues",
  "keywords": [
    "context-window",
    "context-management",
    "compaction",
    "lossless",
    "agents",
    "llm",
    "harness",
    "anthropic",
    "openai",
    "ai-sdk",
    "prompt-caching"
  ],
  "author": "Yoad Elkayam (https://github.com/YoadElkayam)",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./anthropic": {
      "types": "./dist/adapters/anthropic.d.ts",
      "import": "./dist/adapters/anthropic.js"
    },
    "./openai": {
      "types": "./dist/adapters/openai.d.ts",
      "import": "./dist/adapters/openai.js"
    },
    "./ai-sdk": {
      "types": "./dist/adapters/ai-sdk.d.ts",
      "import": "./dist/adapters/ai-sdk.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "windowkeeper": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "pnpm build && node bench/synth.mjs /tmp/windowkeeper-session.json && node bench/replay.mjs /tmp/windowkeeper-session.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "peerDependencies": {
    "@ai-sdk/provider": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.48",
    "@ai-sdk/provider": "4",
    "@anthropic-ai/sdk": "^0.123.0",
    "@types/node": "^26.4.0",
    "ai": "7",
    "fast-check": "^4.9.0",
    "openai": "7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
